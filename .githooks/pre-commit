#!/bin/sh
# my-git branching model: no direct commits on main / develop/base;
# work branches must be named like develop/feat/<name>.
# Generated by my-git setup_repo.py. Enable with: git config core.hooksPath .githooks

git rev-parse -q --verify HEAD >/dev/null 2>&1 || exit 0   # very first commit of the repo
branch=$(git symbolic-ref --short -q HEAD) || exit 0         # detached HEAD (rebase etc.)

case "$branch" in
  "main"|"develop/base")
    echo "pre-commit: direct commits to '$branch' are blocked." >&2
    echo "  Create a work branch: git switch -c develop/feat/<name> develop/base" >&2
    echo "  and merge through a pull request." >&2
    exit 1 ;;
esac

if ! printf '%s\n' "$branch" | grep -Eq '^develop/(feat|fix|chore|docs|refactor|perf|test|build|ci)/[a-z0-9][a-z0-9._-]*$'; then
  echo "pre-commit: branch '$branch' does not match ^develop/(feat|fix|chore|docs|refactor|perf|test|build|ci)/[a-z0-9][a-z0-9._-]*$" >&2
  echo "  Rename it: git branch -m develop/feat/<name>" >&2
  exit 1
fi
exit 0
